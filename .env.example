# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://notion:notion_dev_password@localhost:5433/notion_clone"

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-byte-random-secret"
AUTH_URL="http://localhost:3000"

# --- Object storage (S3-compatible; MinIO locally) ------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="notion-clone-files"
S3_ACCESS_KEY_ID="notion_minio"
S3_SECRET_ACCESS_KEY="notion_minio_password"
S3_FORCE_PATH_STYLE="true"
# Public base URL used to build viewable file links (through a signed-download route)
S3_PUBLIC_BASE_URL="http://localhost:3000/api/files"

# --- Realtime collaboration (apps/realtime) --------------------------------
REALTIME_PORT="1234"
REALTIME_URL="ws://localhost:1234"
# Shared secret used by the web app to mint short-lived room tokens; the realtime
# server verifies these instead of trusting a bare page ID.
REALTIME_JWT_SECRET="replace-with-32-byte-random-secret"

# --- Transactional email (invitations, password reset) --------------------
# Optional: without RESEND_API_KEY, emails are logged to the server console instead of
# sent — the app works fully in local dev either way. To send real email, sign up at
# resend.com (free tier), create an API key, and set it here. EMAIL_FROM must be either
# Resend's shared testing address (onboarding@resend.dev, the default below — only
# delivers to the account's own verified email) or an address on a domain you've
# verified in Resend for production use.
RESEND_API_KEY=""
EMAIL_FROM="Notion Clone <onboarding@resend.dev>"

# --- App --------------------------------------------------------------------
# Do NOT set NODE_ENV here — Next.js sets it itself per command (dev/build/start) and
# a stale value sourced into the shell (e.g. via `source .env`) breaks production
# builds in confusing ways. See docs/DEVELOPMENT.md.
APP_URL="http://localhost:3000"

# --- Google Calendar integration (apps/web/src/server/integrations/google-calendar) ---
# Optional — the whole feature (Settings → Integrations, the Calendar page's "Connect"
# button) hides itself when these two are unset; nothing else breaks. To enable it:
#   1. In Google Cloud Console, create an OAuth 2.0 Client ID (Web application).
#   2. Add an Authorized redirect URI of exactly `${APP_URL}/api/integrations/google/callback`
#      (e.g. http://localhost:3000/api/integrations/google/callback for local dev).
#   3. Enable the "Google Calendar API" for the project (APIs & Services → Library).
#   4. Paste the client ID/secret below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AES-256-GCM key Google's access/refresh tokens are encrypted with before they're
# stored (see packages/shared/src/crypto.ts) — a separate secret from AUTH_SECRET on
# purpose, so rotating one never touches the other. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-random-secret"
