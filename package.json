{
  "name": "notion-clone",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @notion-clone/database db:migrate",
    "db:generate": "pnpm --filter @notion-clone/database db:generate",
    "db:studio": "pnpm --filter @notion-clone/database db:studio",
    "db:seed": "pnpm --filter @notion-clone/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
